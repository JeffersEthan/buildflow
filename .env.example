# Copy this file to .env and fill in real values:
#   cp .env.example .env

# PostgreSQL connection string (used by Prisma).
# Docker Compose sets this automatically for the app container; for local dev
# point it at your own Postgres instance.
DATABASE_URL="postgresql://buildflow:buildflow@localhost:5432/buildflow"

# Secret used by Auth.js to encrypt sessions.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Directory where uploaded project files are stored.
# Docker Compose overrides this to /app/uploads (a named volume).
UPLOAD_DIR="./uploads"
