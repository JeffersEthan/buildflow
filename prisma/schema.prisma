// BuildFlow data model.
// Conventions:
// - Every tenant-scoped row carries companyId. Always filter by it.
// - Money is stored as Decimal(12,2) in dollars. Convert with Number() for display.
// - Dates from <input type="date"> arrive as "YYYY-MM-DD"; construct with new Date(value).

generator client {
  provider = "prisma-client-js"
}

// NOTE (Prisma 7): the datasource keeps only the provider. The connection
// URL for migrations lives in prisma.config.ts, and the PrismaClient in
// lib/db.ts connects through the @prisma/adapter-pg driver adapter.
datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  SUBCONTRACTOR
  CLIENT
}

enum ProjectStatus {
  LEAD
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum ScheduleItemStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum TodoStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FileCategory {
  PHOTO
  DOCUMENT
  PLAN
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
}

enum ChangeOrderStatus {
  DRAFT
  PENDING
  APPROVED
  DECLINED
}

enum SelectionStatus {
  PENDING
  APPROVED
  DECLINED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  clients  Client[]
  projects Project[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         Role     @default(SUBCONTRACTOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client              Client?
  assignedScheduleItems ScheduleItem[] @relation("AssignedScheduleItems")
  assignedTodos       Todo[]           @relation("AssignedTodos")
  createdTodos        Todo[]           @relation("CreatedTodos")
  dailyLogs           DailyLog[]
  uploadedFiles       ProjectFile[]
  sentMessages        Message[]
  decidedSelections   Selection[]      @relation("DecidedSelections")

  @@unique([companyId, email])
  @@index([companyId])
}

model Client {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@index([companyId])
}

model Project {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name        String
  address     String?
  status      ProjectStatus @default(LEAD)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(12, 2)
  description String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  scheduleItems ScheduleItem[]
  todos         Todo[]
  dailyLogs     DailyLog[]
  files         ProjectFile[]
  budgetItems   BudgetItem[]
  estimates     Estimate[]
  changeOrders  ChangeOrder[]
  selections    Selection[]
  messages      Message[]

  @@index([companyId])
  @@index([clientId])
}

model ScheduleItem {
  id           String             @id @default(cuid())
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?            @db.Text
  startDate    DateTime
  endDate      DateTime
  status       ScheduleItemStatus @default(SCHEDULED)
  assignedToId String?
  assignedTo   User?              @relation("AssignedScheduleItems", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([projectId])
}

model Todo {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?      @db.Text
  status       TodoStatus   @default(OPEN)
  priority     TodoPriority @default(MEDIUM)
  dueDate      DateTime?
  assignedToId String?
  assignedTo   User?        @relation("AssignedTodos", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User         @relation("CreatedTodos", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([projectId])
}

model DailyLog {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  weather       String?
  workersOnSite Int?
  hoursWorked   Float?
  notes         String?  @db.Text
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model ProjectFile {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalName String
  storedPath   String
  size         Int
  mimeType     String
  category     FileCategory @default(DOCUMENT)
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())

  @@index([projectId])
}

model BudgetItem {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      String
  name          String
  estimatedCost Decimal  @db.Decimal(12, 2)
  actualCost    Decimal  @default(0) @db.Decimal(12, 2)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model Estimate {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number     String
  title      String
  status     EstimateStatus @default(DRAFT)
  validUntil DateTime?
  notes      String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  lines EstimateLine[]

  @@unique([projectId, number])
  @@index([projectId])
}

model EstimateLine {
  id          String   @id @default(cuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  position    Int      @default(0)

  @@index([estimateId])
}

model ChangeOrder {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      String
  title       String
  description String?           @db.Text
  amount      Decimal           @db.Decimal(12, 2)
  status      ChangeOrderStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([projectId, number])
  @@index([projectId])
}

model Selection {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String?         @db.Text
  status      SelectionStatus @default(PENDING)
  decidedById String?
  decidedBy   User?           @relation("DecidedSelections", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([projectId])
}
